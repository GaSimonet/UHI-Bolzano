figure_scripts/suhi_lcz/suhi_lcz_analysis_valley/*.pdf
figure_scripts/wrf_uhi/*.png
figure_scripts/wrf_uhi/*.pdf
figure_scripts/heatwave2023/*.png
figure_scripts/heatwave2023/*.pdf
figure_scripts/spatiotemporal_scale/*.png
figure_scripts/spatiotemporal_scale/*.pdf

